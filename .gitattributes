* text=auto eol=lf
Cargo.lock linguist-generated

# ROADMAP.md is generated from the items. On a merge, re-derive it rather than
# reconcile two renderings of different inputs.
ROADMAP.md merge=cairn linguist-generated
# An item is source, not a rendering. The driver unions its sequence fields and
# leaves everything else to a person.
cairn/items/*.md merge=cairn
